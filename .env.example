GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_REDIRECT_URI=
# Apple Sign-In (web popup via AppleID.auth.js). Services ID = the web OAuth client ID
# configured in the Apple Developer Console; the redirect URI must be HTTPS and registered
# on that Services ID. The native iOS app uses its own client IDs (in parolla-mobile).
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=
